<div class="narrow">
  <h1>Novo endereço</h1>
  <%= error_summary(@address) %>
  <%= form_with model: @address, url: addresses_path do |a| %>
    <fieldset><%= render "addresses/fields", a: a %></fieldset>
    <div class="actions"><button class="btn" type="submit">Salvar endereço</button> <%= link_to "Voltar", checkout_path %></div>
  <% end %>
</div>
