<%= error_summary(product) %>
<%= form_with model: [:admin, product], class: "card" do |f| %>
  <div class="row row-2">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
    <div class="field"><%= f.label :category_id, "Categoria" %><%= f.collection_select :category_id, Category.all, :id, :name, { include_blank: "Selecione" }, required: true %></div>
  </div>
  <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 3, required: true %></div>
  <div class="field"><%= f.label :ingredients %><%= f.text_area :ingredients, rows: 2, required: true %></div>
  <div class="field"><%= f.label :allergens %><%= f.text_field :allergens, placeholder: "Ex.: leite, ovos, trigo" %></div>
  <div class="row row-3">
    <div class="field"><%= f.label :price %><%= f.number_field :price, step: "0.01", min: "0.01", required: true %></div>
    <div class="field"><%= f.label :stock %><%= f.number_field :stock, min: 0, required: true %></div>
    <div class="field"><%= f.label :min_stock %><%= f.number_field :min_stock, min: 0 %></div>
  </div>
  <div class="field">
    <%= f.label :image_url %>
    <%= f.text_field :image_url, list: "catalog-photos", placeholder: "cupcakes/baunilha-classico.jpg ou https://..." %>
    <datalist id="catalog-photos"><% Product.catalog_photos.each do |photo| %><option value="<%= photo %>"></option><% end %></datalist>
    <span class="hint">Opcional. Escolha uma foto do catálogo ou cole um link. Sem imagem, a vitrine mostra uma ilustração.</span>
  </div>
  <label class="option"><%= f.check_box :active %> <span>Publicar na vitrine</span></label>
  <div class="actions">
    <button class="btn" type="submit">Salvar</button>
    <%= link_to "Cancelar", admin_products_path %>
  </div>
<% end %>
