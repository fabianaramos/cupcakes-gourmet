<h1>Pedidos</h1>
<nav class="chips">
  <%= link_to "Em andamento", admin_orders_path, class: "chip #{'on' if @status.nil?}" %>
  <% Order::STATUSES.each do |st| %>
    <%= link_to Order::STATUS_LABELS[st], admin_orders_path(status: st), class: "chip #{'on' if @status == st}" %>
  <% end %>
</nav>
<%= render "table", orders: @orders %>
<nav class="pagination" aria-label="Paginação">
  <%= link_to "← Anterior", admin_orders_path(status: @status, page: @page - 1) if @page > 1 %>
  <span class="muted">Página <%= @page %> de <%= @total_pages %></span>
  <%= link_to "Próxima →", admin_orders_path(status: @status, page: @page + 1) if @page < @total_pages %>
</nav>
