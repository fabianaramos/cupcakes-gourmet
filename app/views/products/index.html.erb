<% content_for :title, "Vitrine · Cupcakes Gourmet" %>
<% content_for :hero do %>
  <% hero_bg = Dir[Rails.root.join("app/assets/images/hero.{jpg,jpeg,png,webp}")].first %>
  <section class="hero<%= " has-photo" if hero_bg %>"<% if hero_bg %> style="--hero-bg: url('<%= image_path(File.basename(hero_bg)) %>')"<% end %>>
    <div class="wrap hero-inner">
      <div>
        <span class="eyebrow">Confeitaria artesanal</span>
        <h1>Cupcakes que deixam o dia mais doce</h1>
        <p>Feitos todos os dias, com opções veganas e sem glúten. Escolha seus sabores e receba em casa na data que preferir.</p>
        <a class="btn" href="#vitrine">Ver cardápio</a>
      </div>
      <% if !hero_bg && (featured = @products.find { |p| p.image_url&.include?("baunilha") } || @products.find { |p| p.image_url.present? }) %>
        <div class="hero-photo" aria-hidden="true">
          <%= product_image(featured, "") %>
          <span class="sticker">Feito<br>hoje</span>
        </div>
      <% end %>
    </div>
  </section>
<% end if @query.blank? && params[:categoria].blank? %>
<% content_for :band do %>
<div class="wrap section-title" id="vitrine">
  <span class="eyebrow">Nosso cardápio</span>
  <h2>Escolha seus favoritos</h2>
</div>

<section class="search-band" aria-label="Busca e categorias">
<div class="checker checker-flush" aria-hidden="true"></div>
<div class="search-band-inner">
<%= form_with url: products_path, method: :get, class: "filters", role: "search" do %>
  <div class="field">
    <label for="q">Buscar por nome, sabor ou ingrediente</label>
    <input type="search" id="q" name="q" value="<%= @query %>" placeholder="Ex.: chocolate, morango, vegano" list="sugestoes">
    <datalist id="sugestoes">
      <% Product.available.pluck(:name).each do |n| %><option value="<%= n %>"><% end %>
    </datalist>
  </div>
  <div class="field">
    <label for="ordem">Ordenar por</label>
    <%= select_tag :ordem, options_for_select([["Novidades", "novidades"], ["Mais vendidos", "populares"], ["Menor preço", "menor_preco"], ["Maior preço", "maior_preco"]], params[:ordem]), onchange: "this.form.requestSubmit()" %>
  </div>
  <%= hidden_field_tag :categoria, params[:categoria] if params[:categoria].present? %>
  <button class="btn" type="submit">Buscar</button>
<% end %>

<nav class="chips" aria-label="Categorias">
  <%= link_to "Todas", products_path(q: @query.presence, ordem: params[:ordem]), class: "chip #{'on' if params[:categoria].blank?}" %>
  <% @categories.each do |c| %>
    <%= link_to c.name, products_path(categoria: c.id, q: @query.presence, ordem: params[:ordem]), class: "chip #{'on' if params[:categoria].to_s == c.id.to_s}" %>
  <% end %>
</nav>
</div>
</section>
<% end %>

<% if @products.any? %>
  <div class="grid">
    <%= render partial: "card", collection: @products, as: :product %>
  </div>
<% else %>
  <div class="card empty">
    <p><strong>Nenhum cupcake encontrado<%= " para “#{@query}”" if @query.present? %>.</strong></p>
    <p class="muted">Tente outro termo ou confira as sugestões abaixo.</p>
  </div>
  <% if @suggestions.present? %>
    <h2>Talvez você goste</h2>
    <div class="grid"><%= render partial: "card", collection: @suggestions, as: :product %></div>
  <% end %>
<% end %>
